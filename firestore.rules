rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedInNonAnonymous() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isVerifiedNonAnonymous() {
      return isSignedInNonAnonymous()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Platform-level super admin — verified via JWT custom claim, zero extra reads.
    function isSuperAdmin() {
      return isVerifiedNonAnonymous() && request.auth.token.superAdmin == true;
    }

    function isActiveChurch(churchId) {
      return exists(/databases/$(database)/documents/churches/$(churchId))
        && get(/databases/$(database)/documents/churches/$(churchId)).data.isActive == true;
    }

    function getMembership(churchId) {
      return get(/databases/$(database)/documents/churches/$(churchId)/members/$(request.auth.uid)).data;
    }

    function isMember(churchId) {
      let m = getMembership(churchId);
      return isActiveChurch(churchId) && m != null && m.status == 'active';
    }

    function isAdmin(churchId) {
      let m = getMembership(churchId);
      return isActiveChurch(churchId)
        && m != null && m.status == 'active'
        && (m.role == 'admin' || m.role == 'priest');
    }

    function isPriest(churchId) {
      let m = getMembership(churchId);
      return isActiveChurch(churchId)
        && m != null && m.status == 'active'
        && m.role == 'priest';
    }

    function isReceiptManager(churchId) {
      let m = getMembership(churchId);
      return isActiveChurch(churchId)
        && m != null && m.status == 'active'
        && (m.role == 'priest' || m.role == 'treasurer');
    }

    function taxReceiptSummaryOmitsPrivateFields(summary) {
      return !summary.keys().hasAny([
        'givingId',
        'givingIds',
        'donorEmail',
        'donorName',
        'donorAddress',
        'donorLegalName',
        'donorMailingAddress',
        'taxReceiptLegalName',
        'taxReceiptAddress',
        'legalName',
        'mailingAddress',
        'address',
        'email',
        'memberEmail',
        'receiptEmail',
        'organizationName',
        'organizationAddress',
        'organizationTaxId',
        'purpose',
        'contributions',
        'coveredPeriodLabel',
        'duplicateClaimWarning',
        'issuedBy',
        'emailSendingAt',
        'emailSendAttemptId',
        'stripeSessionId',
        'stripeCheckoutSessionId',
        'stripeCheckoutSessionExpiresAt',
        'stripeCheckoutUrl',
        'stripeCheckoutSessionUrl',
        'stripePaymentIntentId',
        'stripePaymentStatus',
        'stripePaymentMethodId',
        'stripeChargeId',
        'stripeCustomerId',
        'stripeEventId',
        'stripeConnectAccountId',
        'stripeConnectTransferId',
        'stripeTransferId',
        'stripeDestinationAccountId',
        'stripeRefundId',
        'stripeRefundStatus',
        'stripeRefundedChargeId',
        'stripeAmountRefundedCents',
        'stripeRefundedAt',
        'checkoutSessionId',
        'checkoutSessionExpiresAt',
        'checkoutSessionUrl',
        'checkoutUrl',
        'paymentIntentId',
        'paymentStatus',
        'paymentMethodId',
        'chargeId',
        'customerId',
        'eventId',
        'refundId',
        'refundStatus',
        'amountRefundedCents',
        'receivedAt',
        'receivedDateLabel',
        'goodsServicesStatement',
        'pdfTemplateVersion',
        'pdfStoragePath',
        'pdfSha256',
        'pdfByteLength',
        'pdfRetainedAt',
        'pdfRetentionStatus',
        'receiptIssueLocation',
        'authorizedSignerName',
        'authorizedSignerTitle',
        'secureElectronicSignatureConfigured',
        'receiptCopiesRetentionConfirmed',
        'partialRefundGivingIds',
        'originalAmountCents',
        'refundedAmountCents',
        'correctionForGivingId',
        'correctionForReceiptId',
        'correctionSourceReason',
        'correctedAt',
        'correctedBy',
        'correctionMarkedAt',
        'correctionMarkedBy',
        'voidedBy'
      ]);
    }

    function taxReceiptSummaryPublicLabelSafe(summary) {
      return summary.donorLabelPublicSafe == true
        && (!summary.keys().hasAny(['donorLabel'])
        || (summary.donorLabel is string
          && summary.donorLabel != 'Anonymous donor'
          && !summary.donorLabel.matches('.*[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}.*')));
    }

    function givingPublicDonorNameSafe(giving) {
      return !giving.keys().hasAny(['donorName'])
        || (giving.donorName is string
          && giving.donorName != 'Anonymous donor'
          && !giving.donorName.matches('.*[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}.*'));
    }

    function givingOmitsPrivatePaymentFields(giving) {
      return !giving.keys().hasAny([
        'stripeSessionId',
        'stripeCheckoutSessionId',
        'stripeCheckoutSessionExpiresAt',
        'stripeCheckoutUrl',
        'stripeCheckoutSessionUrl',
        'stripePaymentIntentId',
        'stripePaymentStatus',
        'stripePaymentMethodId',
        'stripeChargeId',
        'stripeCustomerId',
        'stripeEventId',
        'stripeConnectAccountId',
        'stripeConnectTransferId',
        'stripeTransferId',
        'stripeDestinationAccountId',
        'stripeRefundId',
        'stripeRefundedChargeId',
        'checkoutSessionId',
        'checkoutSessionExpiresAt',
        'checkoutSessionUrl',
        'checkoutUrl',
        'paymentIntentId',
        'paymentStatus',
        'paymentMethodId',
        'chargeId',
        'customerId',
        'eventId',
        'refundId'
      ]);
    }

    function isAssignableClientRole(role) {
      return role == 'member' || role == 'admin' || role == 'treasurer';
    }

    function isValidMembershipStatus(status) {
      return status == 'active' || status == 'suspended';
    }

    function isValidPostStatus(status) {
      return status == 'draft' || status == 'published';
    }

    function isValidNewsletterStatus(status) {
      return status == 'draft' || status == 'published';
    }

    function validString(value, max) {
      return value is string && value.size() <= max;
    }

    function validOptionalString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function validOptionalBool(value) {
      return value == null || value is bool;
    }

    function validOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function validEventSlug(value) {
      return value is string
        && value.matches('^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$');
    }

    function validEventSetupChecklist(value) {
      return value is map
        && value.keys().hasOnly([
          'basics',
          'tickets',
          'schedule',
          'foodDrink',
          'campaigns',
          'staff',
          'payments',
        ])
        && value.basics is bool
        && value.tickets is bool
        && value.schedule is bool
        && value.foodDrink is bool
        && value.campaigns is bool
        && value.staff is bool
        && value.payments is bool;
    }

    function validPublicEventPortal(data, eventId) {
      return data.keys().hasAll([
          'organizationId',
          'organizationType',
          'churchId',
          'title',
          'slug',
          'status',
          'startsAt',
          'endsAt',
          'venueName',
          'venueAddress',
          'heroImageURL',
          'description',
          'modules',
          'focusEnabled',
          'focusStartsAt',
          'focusEndsAt',
          'ticketsEnabled',
          'gateScanningEnabled',
          'reEntryEnabled',
          'foodDrinkEnabled',
          'foodOrderingEnabled',
          'campaignsEnabled',
          'setupChecklist',
        ])
        && data.keys().hasOnly([
          'organizationId',
          'organizationType',
          'churchId',
          'title',
          'slug',
          'status',
          'startsAt',
          'endsAt',
          'venueName',
          'venueAddress',
          'heroImageURL',
          'description',
          'modules',
          'focusEnabled',
          'focusStartsAt',
          'focusEndsAt',
          'ticketsEnabled',
          'gateScanningEnabled',
          'reEntryEnabled',
          'foodDrinkEnabled',
          'foodOrderingEnabled',
          'campaignsEnabled',
          'setupChecklist',
          'createdAt',
          'updatedAt',
        ])
        && data.slug == eventId
        && validEventSlug(data.slug)
        && data.status == 'published'
        && isActiveChurch(data.churchId)
        && validString(data.organizationId, 128)
        && data.organizationType == 'church'
        && validString(data.churchId, 128)
        && validString(data.title, 180)
        && validString(data.description, 5000)
        && validString(data.venueName, 180)
        && validString(data.venueAddress, 300)
        && validOptionalUrl(data.heroImageURL)
        && data.startsAt is timestamp
        && data.endsAt is timestamp
        && data.endsAt > data.startsAt
        && data.modules is list
        && data.modules.size() <= 5
        && data.focusEnabled is bool
        && validOptionalTimestamp(data.focusStartsAt)
        && validOptionalTimestamp(data.focusEndsAt)
        && data.ticketsEnabled is bool
        && data.gateScanningEnabled is bool
        && data.reEntryEnabled is bool
        && data.foodDrinkEnabled is bool
        && data.foodOrderingEnabled is bool
        && data.campaignsEnabled is bool
        && validEventSetupChecklist(data.setupChecklist)
        && validOptionalTimestamp(data.get('createdAt', null))
        && validOptionalTimestamp(data.get('updatedAt', null));
    }

    function validPublicEventTicketTier(data) {
      return data.keys().hasAll([
          'eventId',
          'name',
          'description',
          'priceCents',
          'currency',
          'capacity',
          'perOrderLimit',
          'saleStartsAt',
          'saleEndsAt',
          'active',
        ])
        && data.keys().hasOnly([
          'eventId',
          'name',
          'description',
          'priceCents',
          'currency',
          'capacity',
          'perOrderLimit',
          'saleStartsAt',
          'saleEndsAt',
          'active',
          'createdAt',
          'updatedAt',
        ])
        && validString(data.eventId, 128)
        && validString(data.name, 120)
        && validOptionalString(data.description, 500)
        && data.priceCents is int
        && data.priceCents >= 0
        && data.priceCents <= 10000000
        && data.currency in ['CAD', 'USD']
        && (data.capacity == null || (data.capacity is int && data.capacity >= 0 && data.capacity <= 1000000))
        && data.perOrderLimit is int
        && data.perOrderLimit >= 1
        && data.perOrderLimit <= 50
        && validOptionalTimestamp(data.saleStartsAt)
        && validOptionalTimestamp(data.saleEndsAt)
        && data.active == true;
    }

    function validPublicEventPerformer(data) {
      return data.keys().hasAll([
          'eventId',
          'name',
          'subtitle',
          'description',
          'imageURL',
          'links',
          'published',
        ])
        && data.keys().hasOnly([
          'eventId',
          'name',
          'subtitle',
          'description',
          'imageURL',
          'links',
          'published',
          'createdAt',
          'updatedAt',
        ])
        && validString(data.eventId, 128)
        && validString(data.name, 160)
        && validOptionalString(data.subtitle, 200)
        && validOptionalString(data.description, 3000)
        && validOptionalUrl(data.imageURL)
        && data.links is list
        && data.links.size() <= 10
        && data.published == true;
    }

    function validPublicEventScheduleItem(data) {
      return data.keys().hasAll([
          'eventId',
          'title',
          'description',
          'startTime',
          'endTime',
          'stage',
          'location',
          'performerIds',
          'imageURL',
          'published',
        ])
        && data.keys().hasOnly([
          'eventId',
          'title',
          'description',
          'startTime',
          'endTime',
          'stage',
          'location',
          'performerIds',
          'imageURL',
          'published',
          'createdAt',
          'updatedAt',
        ])
        && validString(data.eventId, 128)
        && validString(data.title, 180)
        && validOptionalString(data.description, 3000)
        && data.startTime is timestamp
        && data.endTime is timestamp
        && data.endTime >= data.startTime
        && validOptionalString(data.stage, 120)
        && validOptionalString(data.location, 180)
        && data.performerIds is list
        && data.performerIds.size() <= 30
        && validOptionalUrl(data.imageURL)
        && data.published == true;
    }

    function validPublicEventMenuItem(data) {
      return data.keys().hasAll([
          'eventId',
          'category',
          'name',
          'description',
          'priceCents',
          'currency',
          'available',
          'soldOut',
          'maxPerOrder',
          'inventoryMode',
          'quantityAvailable',
          'quantitySold',
          'sortOrder',
        ])
        && data.keys().hasOnly([
          'eventId',
          'churchId',
          'category',
          'name',
          'description',
          'priceCents',
          'currency',
          'available',
          'soldOut',
          'maxPerOrder',
          'inventoryMode',
          'quantityAvailable',
          'quantitySold',
          'sortOrder',
          'createdAt',
          'updatedAt',
        ])
        && validString(data.eventId, 128)
        && validOptionalString(data.get('churchId', null), 128)
        && validString(data.category, 80)
        && validString(data.name, 140)
        && validOptionalString(data.description, 500)
        && data.priceCents is int
        && data.priceCents >= 0
        && data.priceCents <= 10000000
        && data.currency in ['CAD', 'USD']
        && data.available == true
        && data.soldOut is bool
        && data.maxPerOrder is int
        && data.maxPerOrder >= 1
        && data.maxPerOrder <= 99
        && data.inventoryMode in ['unlimited', 'tracked']
        && (
          (data.inventoryMode == 'unlimited' && data.quantityAvailable == null)
          || (
            data.inventoryMode == 'tracked'
            && data.quantityAvailable is int
            && data.quantityAvailable >= 0
            && data.quantityAvailable <= 1000000
          )
        )
        && data.quantitySold is int
        && data.quantitySold >= 0
        && data.quantitySold <= 1000000
        && data.sortOrder is int
        && data.sortOrder >= -100000
        && data.sortOrder <= 100000
        && validOptionalTimestamp(data.get('createdAt', null))
        && validOptionalTimestamp(data.get('updatedAt', null));
    }

    function validPublicEventCampaign(data) {
      return data.keys().hasAll([
          'eventId',
          'title',
          'description',
          'suggestedAmountCents',
          'active',
        ])
        && data.keys().hasOnly([
          'eventId',
          'title',
          'description',
          'suggestedAmountCents',
          'active',
          'createdAt',
          'updatedAt',
        ])
        && validString(data.eventId, 128)
        && validString(data.title, 180)
        && validOptionalString(data.description, 1000)
        && data.suggestedAmountCents is int
        && data.suggestedAmountCents >= 0
        && data.suggestedAmountCents <= 10000000
        && data.active == true;
    }

    function validPublicEventAnnouncement(data) {
      return data.keys().hasAll([
          'eventId',
          'churchId',
          'title',
          'body',
          'priority',
          'channels',
          'status',
          'sentAt',
        ])
        && data.keys().hasOnly([
          'eventId',
          'churchId',
          'title',
          'body',
          'priority',
          'channels',
          'status',
          'sentAt',
          'sentByName',
        ])
        && validString(data.eventId, 128)
        && validString(data.churchId, 128)
        && validString(data.title, 120)
        && validString(data.body, 500)
        && data.priority in ['info', 'urgent', 'offer']
        && data.channels is list
        && data.channels.size() <= 3
        && data.status == 'sent'
        && data.sentAt is timestamp
        && validOptionalString(data.get('sentByName', null), 120);
    }

    function validOptionalUrl(value) {
      return value == null
        || value == ''
        || (value is string
          && value.size() <= 2000
          && value.matches('https://.*'));
    }

    function validFcmTokens(tokens) {
      return tokens is list && tokens.size() <= 10;
    }

    function validOptionalFcmTokens(tokens) {
      return tokens == null || validFcmTokens(tokens);
    }

    function validOptionalTaxReceiptAddress(address) {
      return address == null
        || (
          address is map
          && address.keys().hasOnly([
            'line1',
            'line2',
            'city',
            'region',
            'postalCode',
            'country',
          ])
          && validOptionalString(address.line1, 160)
          && validOptionalString(address.line2, 160)
          && validOptionalString(address.city, 100)
          && validOptionalString(address.region, 100)
          && validOptionalString(address.postalCode, 30)
          && validOptionalString(address.country, 80)
        );
    }

    function validTaxReceiptProfileFields(data) {
      return (!data.keys().hasAny(['taxReceiptLegalName'])
          || validOptionalString(data.taxReceiptLegalName, 160))
        && (!data.keys().hasAny(['taxReceiptAddress'])
          || validOptionalTaxReceiptAddress(data.taxReceiptAddress));
    }

    function validUserProfileBase() {
      return request.resource.data.email == request.auth.token.email
        && validString(request.resource.data.displayName, 120)
        && validOptionalUrl(request.resource.data.photoURL)
        && validString(request.resource.data.preferredLanguage, 40)
        && validString(request.resource.data.phone, 40)
        && request.resource.data.ministries is list
        && request.resource.data.ministries.size() <= 20
        && validString(request.resource.data.description, 1000)
        && request.resource.data.showInDirectory is bool
        && validTaxReceiptProfileFields(request.resource.data)
        && validFcmTokens(request.resource.data.fcmTokens);
    }

    function validUserProfileCreate() {
      return request.resource.data.keys().hasOnly([
          'email',
          'displayName',
          'photoURL',
          'preferredLanguage',
          'phone',
          'ministries',
          'description',
          'showInDirectory',
          'taxReceiptLegalName',
          'taxReceiptAddress',
          'fcmTokens',
          'createdAt',
        ])
        && validUserProfileBase()
        && request.resource.data.fcmTokens.size() == 0
        && request.resource.data.createdAt == request.time;
    }

    function validUserProfileUpdate() {
      return request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && validString(request.resource.data.displayName, 120)
        && validOptionalUrl(request.resource.data.photoURL)
        && validString(request.resource.data.preferredLanguage, 40)
        && validOptionalString(request.resource.data.phone, 40)
        && (request.resource.data.ministries == null
          || (request.resource.data.ministries is list && request.resource.data.ministries.size() <= 20))
        && validOptionalString(request.resource.data.description, 1000)
        && validOptionalBool(request.resource.data.showInDirectory)
        && validTaxReceiptProfileFields(request.resource.data)
        && validOptionalFcmTokens(request.resource.data.fcmTokens)
        && (request.resource.data.fcmTokens == resource.data.fcmTokens
          || request.resource.data.fcmTokens == [])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'preferredLanguage',
          'phone',
          'ministries',
          'description',
          'showInDirectory',
          'taxReceiptLegalName',
          'taxReceiptAddress',
          'fcmTokens',
        ]);
    }

    function adminMayEditChurchSettings() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'showSaintDays',
        ])
        && request.resource.data.showSaintDays is bool;
    }

    function validMemberProfileFields() {
      return validOptionalString(request.resource.data.displayName, 120)
        && validOptionalUrl(request.resource.data.photoURL)
        && validOptionalString(request.resource.data.phone, 40)
        && validOptionalString(request.resource.data.ministry, 300)
        && validOptionalString(request.resource.data.description, 1000)
        && validOptionalBool(request.resource.data.showInDirectory);
    }

    function adminMayUpdateMemberStatusOnly(userId) {
      return !isOwner(userId)
        && resource.data.role == 'member'
        && request.resource.data.role == resource.data.role
        && isValidMembershipStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
        ]);
    }

    function ownerMayUpdateOwnMemberProfile(userId) {
      return isOwner(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && validMemberProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'phone',
          'ministry',
          'description',
          'showInDirectory',
        ]);
    }

    function priestMayUpdateMember(userId) {
      return !isOwner(userId)
        && resource.data.role != 'priest'
        && isAssignableClientRole(request.resource.data.role)
        && isValidMembershipStatus(request.resource.data.status)
        && validMemberProfileFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'status',
          'displayName',
          'photoURL',
          'phone',
          'ministry',
          'description',
          'showInDirectory',
        ]);
    }

    function priestMayUpdateMembershipFanout(userId) {
      return !isOwner(userId)
        && resource.data.role != 'priest'
        && isAssignableClientRole(request.resource.data.role)
        && isValidMembershipStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role',
          'status',
        ]);
    }

    function adminMayUpdateMembershipStatusOnly(userId) {
      return !isOwner(userId)
        && resource.data.role == 'member'
        && request.resource.data.role == resource.data.role
        && isValidMembershipStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
        ]);
    }

    function eventBelongsToChurch(eventId, churchId) {
      return exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.churchId == churchId;
    }

    function eventPortalPublished(eventId) {
      return exists(/databases/$(database)/documents/eventPortals/$(eventId))
        && validPublicEventPortal(
          get(/databases/$(database)/documents/eventPortals/$(eventId)).data,
          eventId
        );
    }

    function eventPortalChurchId(eventId) {
      return get(/databases/$(database)/documents/eventPortals/$(eventId)).data.churchId;
    }

    function checkInMemberMatches(churchId, userId) {
      return exists(/databases/$(database)/documents/churches/$(churchId)/members/$(userId))
        && get(/databases/$(database)/documents/churches/$(churchId)/members/$(userId)).data.status == 'active'
        && request.resource.data.memberName == get(/databases/$(database)/documents/churches/$(churchId)/members/$(userId)).data.displayName
        && request.resource.data.memberEmail == get(/databases/$(database)/documents/churches/$(churchId)/members/$(userId)).data.email;
    }

    function validEventCheckInCreate(checkInId) {
      return request.resource.data.keys().hasOnly([
          'churchId',
          'eventId',
          'userId',
          'memberName',
          'memberEmail',
          'checkedInBy',
          'checkedInAt',
        ])
        && validString(request.resource.data.churchId, 128)
        && validString(request.resource.data.eventId, 128)
        && validString(request.resource.data.userId, 128)
        && validString(request.resource.data.memberName, 120)
        && validString(request.resource.data.memberEmail, 254)
        && request.resource.data.checkedInBy == request.auth.uid
        && request.resource.data.checkedInAt == request.time
        && checkInId == request.resource.data.eventId + '_' + request.resource.data.userId
        && eventBelongsToChurch(request.resource.data.eventId, request.resource.data.churchId)
        && checkInMemberMatches(request.resource.data.churchId, request.resource.data.userId);
    }

    function validPostCreate(churchId) {
      return request.resource.data.keys().hasOnly([
          'churchId',
          'authorId',
          'authorName',
          'title',
          'contentHtml',
          'contentJSON',
          'status',
          'createdAt',
          'updatedAt',
          'publishedAt',
        ])
        && request.resource.data.churchId == churchId
        && request.resource.data.authorId == request.auth.uid
        && validString(request.resource.data.authorName, 120)
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.contentHtml, 20000)
        && request.resource.data.contentJSON is map
        && isValidPostStatus(request.resource.data.status)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
          || (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null)
        );
    }

    function validPostUpdate() {
      return request.resource.data.churchId == resource.data.churchId
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.contentHtml, 20000)
        && request.resource.data.contentJSON is map
        && isValidPostStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'contentHtml',
          'contentJSON',
          'status',
          'updatedAt',
          'publishedAt',
        ])
        && (
          request.resource.data.publishedAt == resource.data.publishedAt
          || (
            resource.data.publishedAt == null
            && request.resource.data.status == 'published'
            && request.resource.data.publishedAt == request.time
          )
        );
    }

    function validEventCreate() {
      return request.resource.data.keys().hasOnly([
          'churchId',
          'createdBy',
          'title',
          'description',
          'startTime',
          'endTime',
          'location',
          'category',
          'notificationSent',
          'createdAt',
        ])
        && validString(request.resource.data.churchId, 128)
        && request.resource.data.createdBy == request.auth.uid
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.description, 5000)
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && validString(request.resource.data.location, 300)
        && validString(request.resource.data.category, 80)
        && request.resource.data.notificationSent == false
        && request.resource.data.createdAt == request.time;
    }

    function validEventUpdate() {
      return request.resource.data.churchId == resource.data.churchId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.notificationSent == resource.data.notificationSent
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.description, 5000)
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.endTime > request.resource.data.startTime
        && validString(request.resource.data.location, 300)
        && validString(request.resource.data.category, 80)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'startTime',
          'endTime',
          'location',
          'category',
          'updatedAt',
        ]);
    }

    function validNewsletterCreate() {
      return request.resource.data.keys().hasOnly([
          'churchId',
          'title',
          'content',
          'excerpt',
          'status',
          'publishedAt',
          'createdBy',
          'emailSent',
          'createdAt',
          'updatedAt',
        ])
        && validString(request.resource.data.churchId, 128)
        && request.resource.data.createdBy == request.auth.uid
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.content, 30000)
        && validString(request.resource.data.excerpt, 500)
        && isValidNewsletterStatus(request.resource.data.status)
        && request.resource.data.emailSent == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.status == 'published' && request.resource.data.publishedAt == request.time)
          || (request.resource.data.status == 'draft' && request.resource.data.publishedAt == null)
        );
    }

    function validNewsletterUpdate() {
      return request.resource.data.churchId == resource.data.churchId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.emailSent == resource.data.emailSent
        && request.resource.data.createdAt == resource.data.createdAt
        && validString(request.resource.data.title, 180)
        && validString(request.resource.data.content, 30000)
        && validString(request.resource.data.excerpt, 500)
        && isValidNewsletterStatus(request.resource.data.status)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'content',
          'excerpt',
          'status',
          'publishedAt',
          'updatedAt',
        ])
        && (
          request.resource.data.publishedAt == resource.data.publishedAt
          || (
            resource.data.publishedAt == null
            && request.resource.data.status == 'published'
            && request.resource.data.publishedAt == request.time
          )
        );
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isSignedInNonAnonymous() && isOwner(userId);
      allow create: if isSignedInNonAnonymous() && isOwner(userId) && validUserProfileCreate();
      allow update: if isSignedInNonAnonymous() && isOwner(userId) && validUserProfileUpdate();
      allow delete: if false;

      match /churchMemberships/{churchId} {
        allow read: if (isSignedInNonAnonymous() && isOwner(userId)) || isSuperAdmin();
        allow create: if false;
        allow delete: if isVerifiedNonAnonymous() && isOwner(userId)
          && get(/databases/$(database)/documents/churches/$(churchId)/members/$(userId)).data.status == 'active'
          && !existsAfter(/databases/$(database)/documents/churches/$(churchId)/members/$(userId));
        allow update: if isVerifiedNonAnonymous() && (
          (isPriest(churchId) && priestMayUpdateMembershipFanout(userId))
          || (isAdmin(churchId) && adminMayUpdateMembershipStatusOnly(userId))
        );
      }
    }

    // ─── Churches ─────────────────────────────────────────────────────────────

    match /churches/{churchId} {
      allow read: if isSuperAdmin() || resource.data.isActive == true;
      allow create: if false;

      // Client-side church edits are limited to low-risk feature toggles.
      // Broader metadata/state changes must go through audited backend code.
      allow update: if isVerifiedNonAnonymous() && isAdmin(churchId) && adminMayEditChurchSettings();

      allow delete: if false;

      match /members/{userId} {
        allow read: if isSuperAdmin()
          || (isVerifiedNonAnonymous() && isAdmin(churchId))
          || (isSignedInNonAnonymous() && isOwner(userId))
          || (
            isVerifiedNonAnonymous()
            && isMember(churchId)
            && resource.data.status == 'active'
            && resource.data.showInDirectory == true
          );
        allow create: if false;
        // Role changes are priest-only, but client-side promotion to priest is blocked.
        // Admins can suspend/reinstate members only.
        // Members can update their own directory profile fields.
        allow update: if isVerifiedNonAnonymous() && (
          (isPriest(churchId) && priestMayUpdateMember(userId))
          || (isAdmin(churchId) && adminMayUpdateMemberStatusOnly(userId))
          || ownerMayUpdateOwnMemberProfile(userId)
        );
        allow delete: if isVerifiedNonAnonymous() && isOwner(userId)
          && resource.data.status == 'active'
          && !existsAfter(/databases/$(database)/documents/users/$(userId)/churchMemberships/$(churchId));
      }

      // ─── Church Posts ──────────────────────────────────────────────────────

      match /posts/{postId} {
        // Published posts are readable by any active member; drafts only by admins/priests.
        allow read: if isSuperAdmin()
          || (isVerifiedNonAnonymous() && isAdmin(churchId))
          || (isVerifiedNonAnonymous() && isMember(churchId) && resource.data.status == 'published');

        allow create: if isVerifiedNonAnonymous()
          && isAdmin(churchId)
          && validPostCreate(churchId);

        allow update: if isVerifiedNonAnonymous()
          && isAdmin(churchId)
          && validPostUpdate();

        allow delete: if isVerifiedNonAnonymous() && isAdmin(churchId);
      }
    }

    // ─── Events ───────────────────────────────────────────────────────────────

    match /events/{eventId} {
      allow read: if isSuperAdmin() || (isVerifiedNonAnonymous() && isMember(resource.data.churchId));
      allow create: if isVerifiedNonAnonymous()
        && isAdmin(request.resource.data.churchId)
        && validEventCreate();
      allow update: if isVerifiedNonAnonymous()
        && isAdmin(resource.data.churchId)
        && validEventUpdate();
      allow delete: if isVerifiedNonAnonymous() && isAdmin(resource.data.churchId);
    }

    // ─── Kandilo Events Platform ─────────────────────────────────────────────

    match /eventPortals/{eventId} {
      allow read: if validPublicEventPortal(resource.data, eventId)
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(resource.data.churchId));
      // Event setup writes go through saveEventPortalSetup so slug uniqueness,
      // schema validation, and Featured Event locking are enforced transactionally.
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventTicketTiers/{tierId} {
      allow read: if (validPublicEventTicketTier(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventPerformers/{performerId} {
      allow read: if (validPublicEventPerformer(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventScheduleItems/{scheduleItemId} {
      allow read: if (validPublicEventScheduleItem(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventMenuItems/{menuItemId} {
      allow read: if (validPublicEventMenuItem(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventCampaigns/{campaignId} {
      allow read: if (validPublicEventCampaign(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      allow create, update: if false;
      allow delete: if false;
    }

    match /eventAnnouncements/{announcementId} {
      allow read: if (validPublicEventAnnouncement(resource.data) && eventPortalPublished(resource.data.eventId))
        || isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId)));
      // Announcement delivery is backend-only so email/push/audit fields cannot be forged by clients.
      allow create, update, delete: if false;
    }

    match /eventAnnouncementDelivery/{announcementId} {
      allow read, write: if false;
    }

    match /eventFeaturedByChurch/{churchId} {
      allow read, write: if false;
    }

    match /eventTickets/{ticketId} {
      allow read: if isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /eventTicketPrivate/{ticketId} {
      allow read, write: if false;
    }

    match /eventTicketScans/{scanId} {
      allow read: if isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /eventOrders/{orderId} {
      allow read: if isVerifiedNonAnonymous() && isAdmin(eventPortalChurchId(resource.data.eventId));
      allow create, update, delete: if false;
    }

    match /eventOrderPrivate/{orderId} {
      allow read, write: if false;
    }

    // ─── Newsletters ──────────────────────────────────────────────────────────

    match /newsletters/{newsletterId} {
      allow read: if isSuperAdmin()
        || (isVerifiedNonAnonymous() && isAdmin(resource.data.churchId))
        || (
          isVerifiedNonAnonymous()
          && isMember(resource.data.churchId)
          && resource.data.status == 'published'
        );
      allow create: if isVerifiedNonAnonymous()
        && isAdmin(request.resource.data.churchId)
        && validNewsletterCreate();
      allow update: if isVerifiedNonAnonymous()
        && isAdmin(resource.data.churchId)
        && validNewsletterUpdate();
      allow delete: if isVerifiedNonAnonymous() && isPriest(resource.data.churchId);
    }

    // ─── Invitations ──────────────────────────────────────────────────────────

    match /invitations/{invitationId} {
      allow read: if isSuperAdmin() || (isSignedInNonAnonymous() && (
        (request.auth.token.email == resource.data.inviteeEmail)
        || (isVerifiedNonAnonymous() && isAdmin(resource.data.churchId))
      ));
      // Invitation lifecycle is enforced exclusively via Cloud Functions.
      allow create, update, delete: if false;
    }

    // ─── Notifications ────────────────────────────────────────────────────────

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin() || (isVerifiedNonAnonymous() && isMember(resource.data.churchId));
      allow write: if false;
    }

    // ─── Giving ───────────────────────────────────────────────────────────────

    match /giving/{givingId} {
      allow read: if isVerifiedNonAnonymous() && (
        isOwner(resource.data.get('userId', ''))
        || (
          isReceiptManager(resource.data.churchId)
          && resource.data.anonymous == false
          && resource.data.churchReceiptVisible == true
          && resource.data.donorEmail == ''
          && resource.data.donorNamePublicSafe == true
          && resource.data.receiptManagerGivingSafeVersion == 1
          && givingPublicDonorNameSafe(resource.data)
          && givingOmitsPrivatePaymentFields(resource.data)
          && resource.data.status in ['completed', 'refunded']
        )
      );
      // All writes are performed exclusively by Cloud Functions (Admin SDK, bypasses rules).
      allow create, update, delete: if false;
    }

    // ─── Stripe Webhook Audit Events ─────────────────────────────────────────

    match /stripeWebhookEvents/{stripeWebhookEventId} {
      // Raw Stripe event records contain Stripe object IDs and giving IDs.
      // Mission Control reads only redacted summaries via getPaymentOperationsReadiness.
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ─── Giving Payment Metadata ────────────────────────────────────────────

    match /givingPaymentMetadata/{givingId} {
      // Raw Stripe session, PaymentIntent, and charge identifiers stay backend-only.
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ─── Church Payment Settings ─────────────────────────────────────────────

    match /churchPaymentSettings/{churchId} {
      // Connected account IDs and routing switches are backend-only. Mission
      // Control uses SuperAdmin callables instead of direct Firestore reads.
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ─── Tax Receipts ────────────────────────────────────────────────────────

    match /taxReceipts/{taxReceiptId} {
      allow read: if isVerifiedNonAnonymous() && isOwner(resource.data.userId);
      // Official receipt issuance, voiding, and email state are backend-only.
      allow create, update, delete: if false;
    }

    // ─── Tax Receipt Operational Summaries ─────────────────────────────────────

    match /taxReceiptSummaries/{taxReceiptSummaryId} {
      allow read: if isVerifiedNonAnonymous() && (
        isOwner(resource.data.userId)
        || (
          isReceiptManager(resource.data.churchId)
          && resource.data.kind == 'annual'
          && resource.data.donorAnonymous == false
          && resource.data.churchReceiptVisible == true
          && resource.data.receiptManagerSummarySafe == true
          && resource.data.receiptManagerSummarySafeVersion == 2
          && resource.data.donorLabelPublicSafe == true
          && taxReceiptSummaryPublicLabelSafe(resource.data)
          && taxReceiptSummaryOmitsPrivateFields(resource.data)
        )
      );
      // Minimal operational mirrors are written only by Cloud Functions.
      allow create, update, delete: if false;
    }

    // ─── Tax Receipt Audit Events ─────────────────────────────────────────────

    match /taxReceiptEvents/{taxReceiptEventId} {
      // Internal operational audit records. Mission Control reads only the
      // whitelisted redacted feed exposed by getTaxReceiptAuditEvents.
      allow read: if false;
      allow create, update, delete: if false;
    }

    // ─── Event Check-ins ─────────────────────────────────────────────────────

    match /eventCheckIns/{checkInId} {
      allow read: if isSuperAdmin() || (isSignedInNonAnonymous() && (
          (isVerifiedNonAnonymous() && isAdmin(resource.data.churchId))
          || (isSignedInNonAnonymous() && isOwner(resource.data.userId))
      ));
      allow create: if isVerifiedNonAnonymous()
        && isAdmin(request.resource.data.churchId)
        && validEventCheckInCreate(checkInId);
      allow update: if false;
      allow delete: if isVerifiedNonAnonymous() && isAdmin(resource.data.churchId);
    }

    // ─── Platform Audit Log ──────────────────────────────────────────────────

    match /platformAuditLog/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ─── Saints Calendar ─────────────────────────────────────────────────────
    // Public read — no auth required. Static liturgical reference data.
    // Writes go through admin scripts only; client writes are permanently blocked.

    match /saints/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /saints_index/{date} {
      allow read: if true;
      allow write: if false;
    }

    match /saints_index_months/{month} {
      allow read: if true;
      allow write: if false;
    }
  }
}
