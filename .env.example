# ── Gemini AI ────────────────────────────────────────────────────────────────
# Required for the Faith AI screen. Set in AI Studio via the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL="https://app.kandilo.org"
MOBILE_APP_URL="kandilo://app/"

# ── Firebase (Client SDK) ─────────────────────────────────────────────────────
# All VITE_ prefixed vars are exposed to the browser bundle.
# These are public identifiers — not secrets. Safe to commit to version control.
# Find them in: Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY="AIza..."
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="kandilo-2f7a9.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abc123"
VITE_FIREBASE_APP_CHECK_SITE_KEY="6L..."
# Optional local development token. Register the debug token in Firebase App Check
# before using it against an App Check-enforced project.
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=""

# Optional local-only browser Firebase emulator wiring. Keep disabled for
# production builds and set true only when running Firebase emulators locally.
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_AUTH_EMULATOR_PORT="9098"
VITE_FIRESTORE_EMULATOR_PORT="8088"
VITE_FIREBASE_FUNCTIONS_EMULATOR_PORT="5008"
VITE_FIREBASE_STORAGE_EMULATOR_PORT="9198"

# ── Firebase Cloud Messaging (Web Push VAPID key) ─────────────────────────────
# Find in: Firebase Console → Project Settings → Cloud Messaging → Web Push certificates
# Click "Generate key pair" if you haven't already.
VITE_FIREBASE_VAPID_KEY="BN..."

# ── Deferred AI UI ───────────────────────────────────────────────────────────
# Keep these false until GEMINI_API_KEY is configured and AI flows are tested.
VITE_ENABLE_FAITH_AI="false"
VITE_ENABLE_AI_WRITER="false"

# Set to "true" for a public holding page build that hides the app shell.
VITE_COMING_SOON="false"

# ── Cloud Functions: Resend API Key ───────────────────────────────────────────
# Prefer npm run configure:receipt-secrets; direct fallback:
# npx --no-install firebase functions:secrets:set RESEND_API_KEY --project kandilo-2f7a9
# Do NOT put this in .env files — it is a backend secret.
# RESEND_API_KEY="re_..."

# ── Cloud Functions: Stripe Secrets ──────────────────────────────────────────
# Set these as Firebase secrets after Stripe account/webhook setup.
# Do NOT put live Stripe secrets in .env files.
# npx --no-install firebase functions:secrets:set STRIPE_SECRET_KEY --project kandilo-2f7a9
# npx --no-install firebase functions:secrets:set STRIPE_WEBHOOK_SECRET --project kandilo-2f7a9
